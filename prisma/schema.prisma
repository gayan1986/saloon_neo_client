// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  email String @unique
  phone String? @unique  // "?" aniwarya nehe kiyana eka 
  fristName String 
  LastName String
  password String
  role String @default("CUSTOMER")
  status String @default("ACTIVE") // ACTIVE, BANNED, SUSPENDED
  createdAt DateTime @default(now())
  lastLogin DateTime?
  privileges String[] @default([])
  profileImage String @default("image/default-profile.png")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DELETED
}

model Product{
  id String @id @default(uuid())
  sku String @unique
  name String
  altName String[] @default([])
  description String
  stock Int @default(0)
  status ProductStatus @default(ACTIVE)
  price Float
  compareAt Float?
  brand String?
  model String?
  media Media[]  // one to many relationship  
}

enum MediaType {
  IMAGE
  VIDEO
}

model Media{
  id String @id @default(uuid())
  url String
  type MediaType
  productID String
  product Product @relation(fields: [productID], references: [id])
}